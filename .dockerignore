# Docker ignore file for Datadog IaC Tagging Compliance Tool

# Git and version control
.git
.gitignore
.github

# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Terraform files (we copy these specifically)
terraform/.terraform/
terraform/terraform.tfstate*
terraform/.terraform.lock.hcl

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation that's not needed in container
README.md
CHANGELOG.md
LICENSE

# Results and temporary files
results/
*.log
*.tmp

# Testing
.pytest_cache/
.coverage
htmlcov/

# Makefile (not needed in container)
Makefile
